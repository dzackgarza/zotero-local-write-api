# Cloudflare tunnel config for the Zotero Local Write API.
# Generated by `just tunnel-setup` — __TUNNEL_UUID__ is substituted with the
# UUID of the "zotero-write" named tunnel on this machine.
#
# The origin is Zotero's built-in HTTP server, which binds 127.0.0.1 only.
# That port also hosts Zotero's UNAUTHENTICATED local read API and the
# connector endpoints, so the ingress exposes exactly the four plugin routes
# and nothing else.
tunnel: __TUNNEL_UUID__
credentials-file: __HOME__/.cloudflared/__TUNNEL_UUID__.json

# This host has no working IPv6 egress: cloudflared binds [::] for QUIC and
# every dial fails with "sendmsg: network is unreachable". Force IPv4 and use
# http2 (TCP 7844) rather than QUIC (UDP 7844). edge-ip-version MUST be a
# quoted string; cloudflared rejects the bare int.
edge-ip-version: "4"
protocol: http2

ingress:
  - hostname: zotero-write.dzackgarza.com
    path: ^/(write|attach|version|openapi\.yaml)$
    service: http://127.0.0.1:23119
  # Anything else on port 23119 (Zotero read API, connector) stays private.
  - service: http_status:404
