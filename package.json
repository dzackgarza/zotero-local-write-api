{
  "name": "local-write-api",
  "devDependencies": {
    "@redocly/cli": "^2.39.0",
    "@types/bun": "latest",
    "esbuild": "^0.27.3",
    "js-yaml": "^5.2.1",
    "openapi-fetch": "^0.17.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "zotero-types": "^4.1.2"
  },
  "private": true,
  "scripts": {
    "build": "esbuild src/bootstrap.ts --bundle --format=esm --tree-shaking=false --outfile=src/bootstrap.js --target=firefox115",
    "typecheck": "tsc --noEmit",
    "test": "bun test --coverage --coverage-reporter=lcov --coverage-dir=.",
    "openapi:lint": "redocly lint openapi.yaml",
    "openapi:generate": "openapi-typescript openapi.yaml | dev/openapi-types.sh write",
    "openapi:check-generated": "openapi-typescript openapi.yaml | dev/openapi-types.sh check",
    "openapi:contract": "bun test tests/openapi-contract.test.ts",
    "openapi:check": "bun run openapi:lint && bun run openapi:check-generated && bun run openapi:contract",
    "client:live": "bun test ./tests/live/client.live.ts",
    "import-from-url:live": "bun test --timeout 180000 ./tests/live/import-from-url.live.ts"
  },
  "type": "module",
  "dependencies": {
    "valibot": "^1.5.0"
  }
}
